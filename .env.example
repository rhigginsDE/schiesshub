# Copy to .env and fill in local values. Never commit .env!
#
# Die Werte unten sind Standardwerte für die Entwicklung auf dem eigenen Rechner.
# Für einen echten Server eigene Zugangsdaten setzen.

# --- Datenbank (Dienst "db", von außen nur unter 127.0.0.1:5442 erreichbar) ---
POSTGRES_DB=schiesshub
POSTGRES_USER=schiesshub
POSTGRES_PASSWORD=schiesshub-dev-nur-lokal

# --- Backend (Dienst "backend", http://localhost:8010) ---
# Erlaubte Browser-Herkünfte (CORS), mehrere mit Komma trennen.
CORS_ORIGINS=http://localhost:5180
LOG_LEVEL=INFO

# --- Anmeldung und Rechte ---
# Berechtigungsprüfung für alle Endpunkte. In der frühen Entwicklung aus, bis die Oberfläche
# Kopplung und Anmeldung kann.
AUTH_ENFORCED=false
