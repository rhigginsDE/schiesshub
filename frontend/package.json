{
  "name": "schiesshub-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN ../LICENSE",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "gen:api": "pnpm --package=openapi-typescript@7.13.0 --package=typescript@5.9.3 dlx openapi-typescript http://127.0.0.1:8010/api/v1/openapi.json -o src/api/schema.gen.ts"
  },
  "dependencies": {
    "@fontsource/exo-2": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@mantine/core": "9.8.2",
    "@mantine/hooks": "9.8.2",
    "@tanstack/react-query": "5.108.2",
    "@tanstack/react-router": "1.170.46",
    "i18next": "27.2.3",
    "lucide-react": "1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.3",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
